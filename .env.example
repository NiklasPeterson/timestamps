# Leave analytics disabled in local development and Preview deployments.
# Set both values to true only in Vercel's Production environment.
NEXT_PUBLIC_ANALYTICS_ENABLED=
ANALYTICS_ENABLED=

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
